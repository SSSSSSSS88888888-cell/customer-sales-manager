generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// User（ユーザー）
// ==========================================
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String?   // OAuth用にnullable
  name          String
  image         String?   // プロフィール画像URL
  emailVerified DateTime? // メール確認日時
  isGuest       Boolean   @default(false) // ゲストユーザーフラグ
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // NextAuth.js用リレーション
  accounts  Account[]
  sessions  Session[]

  // ビジネスロジック用リレーション
  chartOfAccounts    ChartOfAccount[]
  journals           Journal[]
  budgets            Budget[]
  recurringJournals  RecurringJournal[]
}

// ==========================================
// NextAuth.js用テーブル
// ==========================================
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// AccountType（勘定科目区分）
// ==========================================
enum AccountType {
  ASSET      // 資産
  LIABILITY  // 負債
  EQUITY     // 純資産
  REVENUE    // 収益
  EXPENSE    // 費用
}

// ==========================================
// ChartOfAccount（勘定科目マスタ）
// ==========================================
model ChartOfAccount {
  id        String      @id @default(uuid())
  userId    String
  code      String      // 勘定科目コード（101, 401など）
  name      String      // 勘定科目名（現金、売上高など）
  type      AccountType // 勘定科目区分
  category  String      // カテゴリ（流動資産、固定資産、売上原価など）
  isSystem  Boolean     @default(false) // システム標準科目フラグ
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  debitJournals            Journal[]          @relation("DebitAccount")
  creditJournals           Journal[]          @relation("CreditAccount")
  debitRecurringJournals   RecurringJournal[] @relation("DebitRecurringAccount")
  creditRecurringJournals  RecurringJournal[] @relation("CreditRecurringAccount")

  @@unique([userId, code])
  @@index([userId])
}

// ==========================================
// Journal（仕訳）
// ==========================================
model Journal {
  id              String   @id @default(uuid())
  userId          String
  date            DateTime // 仕訳日付
  debitAccountId  String   // 借方勘定科目ID
  creditAccountId String   // 貸方勘定科目ID
  amount          Int      // 金額（円単位）
  description     String?  // 摘要
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  debitAccount  ChartOfAccount @relation("DebitAccount", fields: [debitAccountId], references: [id])
  creditAccount ChartOfAccount @relation("CreditAccount", fields: [creditAccountId], references: [id])

  @@index([userId])
  @@index([date])
  @@index([debitAccountId])
  @@index([creditAccountId])
}

// ==========================================
// Budget（予算）
// ==========================================
model Budget {
  id        String   @id @default(uuid())
  userId    String
  year      Int      // 予算年度
  month     Int      // 予算月（1-12）
  category  String   // カテゴリ（売上、費用など）
  amount    Int      // 予算金額
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month, category])
  @@index([userId])
  @@index([year, month])
}

// ==========================================
// Frequency（定期仕訳の頻度）
// ==========================================
enum Frequency {
  DAILY    // 毎日
  WEEKLY   // 毎週
  MONTHLY  // 毎月
  YEARLY   // 毎年
}

// ==========================================
// RecurringJournal（定期仕訳）
// ==========================================
model RecurringJournal {
  id              String    @id @default(uuid())
  userId          String
  name            String    // 定期仕訳名（例：家賃支払い）
  debitAccountId  String    // 借方勘定科目ID
  creditAccountId String    // 貸方勘定科目ID
  amount          Int       // 金額
  description     String?   // 摘要
  frequency       Frequency // 頻度
  dayOfMonth      Int?      // 月次の場合の実行日（1-31）
  dayOfWeek       Int?      // 週次の場合の曜日（0=日曜〜6=土曜）
  startDate       DateTime  // 開始日
  endDate         DateTime? // 終了日（null=無期限）
  isActive        Boolean   @default(true) // 有効フラグ
  lastGeneratedAt DateTime? // 最終生成日
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  debitAccount  ChartOfAccount @relation("DebitRecurringAccount", fields: [debitAccountId], references: [id])
  creditAccount ChartOfAccount @relation("CreditRecurringAccount", fields: [creditAccountId], references: [id])

  @@index([userId])
  @@index([isActive])
}
